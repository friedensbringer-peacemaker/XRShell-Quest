# Theme Park (Bullfrog, 1994, DOS/GOG) — als xrshell.keys in den Spielordner legen.
# Y bleibt frei: Y öffnet/schließt die Bildschirmtastatur (z. B. für den Parknamen).
a = R            # Auflösung umschalten: 320×200 ↔ 640×480 (SVGA) — im Park drücken
# X bleibt frei: Bildzoom um den Strahlpunkt (XRShell-Standard).
# VR-Menü → DOS → „Hohe Auflösung umschalten“ (gleiche Taste wie A):
hires = R
