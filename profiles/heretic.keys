# Heretic (DOS, 1.3) - Rueckfall fuer den Maus-Modus (ohne xrshell_input = pad), als xrshell.keys
# in den Spielordner legen. Im Pad-Modus gilt DOS.YML (profiles/heretic.yml).
# Maus-Modus: rechter Stick = Pfeiltasten (vor/zurueck/drehen), Trigger/B = Maustasten.
# Y bleibt Bildschirmtastatur (fuer "Y" in Abfragen und seltene Tasten).

left_stick_up     = UP        # vorwaerts
left_stick_down   = DOWN      # rueckwaerts
left_stick_left   = COMMA     # seitwaerts links
left_stick_right  = PERIOD    # seitwaerts rechts
left_trigger = LCTRL          # feuern
a = SPACE                     # benutzen / oeffnen
x = ENTER                     # Artefakt benutzen / Menue OK (ersetzt den Bildzoom)
right_stick_click = ESC       # Menue
