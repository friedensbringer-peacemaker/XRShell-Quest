# Heretic (DOS, 1.3) - als xrshell.opt in den Spielordner legen (von Hand; prepare-dos-games.ps1
# hat dafuer keinen Zweig). Vorbereitet, ungeprueft gegen echte Installer und im Headset.
# Kaufversion/Dateien/Start: docs/DOS-SPIELE.md, Abschnitt "Shooter".
#
# Pad-Modus: RetroPad mit Analogsticks an Port 0, kein Laser-Mauszeiger. Belegung aus
# C:\DOS.YML (profiles/heretic.yml), sonst die eingebaute Keyb2Joypad-Belegung von DOSBox Pure.
xrshell_input = pad
dosbox_pure_auto_mapping = true
# Doom-Engine wie Doom: volle Leistung.
dosbox_pure_cycles = max
# Soundblaster 16 wie die anderen Profile (220h, IRQ 7, DMA 1, HDMA 5); DEFAULT.CFG im Spielordner
# (SETUP.EXE): snd_sfxdevice 3, snd_musicdevice 3 (OPL), snd_sbport 544, snd_sbirq 7, snd_sbdma 1.

dosbox_pure_sblaster_type = sb16
dosbox_pure_sblaster_conf = A220 I7 D1 H5
# Bild: Scharf statt HD (xBR). xBR glaettet Pixel-Art-Kanten und verschmiert die perspektivischen
# Wand-/Bodentexturen eines 3D-Shooters zu Klecksen; im VR-Menue pro Spiel aenderbar.
xrshell_filter = scharf
